# Vercel only. Never use NEXT_PUBLIC_ prefixes for these values.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Optional fallback for an existing legacy service_role JWT:
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=
SESSION_SECRET=
# Obtain the key for admin@example.com from Web3Forms; "svg" is not a key.
WEB3FORMS_ACCESS_KEY=

# Optional bridge; leave blank when using Supabase directly.
PORTFOLIO_BACKEND_URL=
PORTFOLIO_BRIDGE_SECRET=
PORTFOLIO_SITES_TOKEN=
